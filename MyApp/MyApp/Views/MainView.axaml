<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:MyApp.Data"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MyApp.Views.MainView">

	<TabControl>
		<TabItem Header="Команды">
			<Grid ColumnDefinitions="Auto, *">
				<ListBox x:Name="TeamsList" Grid.Column="0" Width="300" Margin="10" SelectionChanged="TeamsList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Team">
							<TextBlock Text="{Binding TeamName}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				
				<StackPanel Grid.Column="1" Margin="10" Spacing="10">
					<TextBlock Text="Название команды:" />
					<TextBox x:Name="TeamNameBox" Width="250" />

					<TextBlock Text="Количество человек:" />
					<TextBox x:Name="TeamMembersBox" Width="250" />

					<CheckBox x:Name="TeamIsExperiencedBox" Content="Опытная команда" />

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Добавить" Click="AddTeam_Click" />
						<Button Content="Сохранить" Click="SaveTeam_Click" />
						<Button Content="Удалить" Click="DeleteTeam_Click" />
					</StackPanel>

					<TextBlock x:Name="TeamMessage" Foreground="Red" />
				</StackPanel>
			</Grid>
		</TabItem>

		<TabItem Header="Квесты">
			<Grid ColumnDefinitions="Auto, *">
				<ListBox x:Name="QuestsList" Grid.Column="0" Width="300" Margin="10" SelectionChanged="QuestsList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Quest">
							<TextBlock Text="{Binding QuestTitle}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<StackPanel Grid.Column="1" Margin="10" Spacing="10">
					<TextBlock Text="Название квеста:" />
					<TextBox x:Name="QuestTitleBox" Width="250" />

					<TextBlock Text="Сложность (1-5):" />
					<TextBox x:Name="QuestDifficultyBox" Width="250" />

					<TextBlock Text="Длительность (мин):" />
					<TextBox x:Name="QuestDurationBox" Width="250" />

					<TextBlock Text="Количество реактивов:" />
					<TextBox x:Name="QuestReagentsBox" Width="250" />

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Добавить" Click="AddQuest_Click" />
						<Button Content="Сохранить" Click="SaveQuest_Click" />
						<Button Content="Удалить" Click="DeleteQuest_Click" />
					</StackPanel>

					<TextBlock x:Name="QuestMessage" Foreground="Red" />
				</StackPanel>
			</Grid>
		</TabItem>

		<TabItem Header="Прохождения">
			<Grid ColumnDefinitions="Auto, *">
				<ListBox x:Name="PlaythroughsList" Grid.Column="0" Width="300" Margin="10">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Playthrough">
							<TextBlock>
								<Run Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
								<Run Text=" | " />
								<Run Text="{Binding Team.TeamName}" />
								<Run Text=" - " />
								<Run Text="{Binding Quest.QuestTitle}" />
							</TextBlock>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<StackPanel Grid.Column="1" Margin="10" Spacing="10">
					<TextBlock Text="Выберите команду:" />
					<ComboBox x:Name="PlaythroughTeamCombo" Width="250" />

					<TextBlock Text="Выберите квест:" />
					<ComboBox x:Name="PlaythroughQuestCombo" Width="250" />

					<TextBlock Text="Дата и время:" />
					<CalendarDatePicker x:Name="PlaythroughDatePicker" Width="250" />
					<TimePicker x:Name="PlaythroughTimePicker" Width="250" />

					<CheckBox x:Name="PlaythroughIsSuccessBox" Content="Успешно" />

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Добавить" Click="AddPlaythrough_Click" />
						<Button Content="Удалить" Click="DeletePlaythrough_Click" />
					</StackPanel>

					<TextBlock x:Name="PlaythroughMessage" Foreground="Red" />
				</StackPanel>
			</Grid>
		</TabItem>
	</TabControl>
</UserControl>
