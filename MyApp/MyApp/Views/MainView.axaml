<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:MyApp.Data"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="MyApp.Views.MainView">

	<TabControl>
		<TabItem Header="Команды">
			<ScrollViewer>
				<StackPanel Margin="10" Spacing="10">
					<ListBox x:Name="TeamsList" MaxHeight="200" SelectionChanged="TeamsList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Team">
								<TextBlock Text="{Binding TeamName}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<TextBlock Text="Название команды:" />
					<TextBox x:Name="TeamNameBox" />

					<TextBlock Text="Количество человек:" />
					<TextBox x:Name="TeamMembersBox" />

					<CheckBox x:Name="TeamIsExperiencedBox" Content="Опытная команда" MinHeight="40" />

					<Button Content="Добавить" Click="AddTeam_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Сохранить" Click="SaveTeam_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Удалить" Click="DeleteTeam_Click" MinHeight="40" HorizontalAlignment="Stretch" />

					<TextBlock x:Name="TeamMessage" Foreground="Red" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<TabItem Header="Квесты">
			<ScrollViewer>
				<StackPanel Margin="10" Spacing="10">
					<ListBox x:Name="QuestsList" MaxHeight="200" SelectionChanged="QuestsList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Quest">
								<TextBlock Text="{Binding QuestTitle}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<TextBlock Text="Название квеста:" />
					<TextBox x:Name="QuestTitleBox" />

					<TextBlock Text="Сложность (1-5):" />
					<TextBox x:Name="QuestDifficultyBox" />

					<TextBlock Text="Длительность (мин):" />
					<TextBox x:Name="QuestDurationBox" />

					<TextBlock Text="Количество реактивов:" />
					<TextBox x:Name="QuestReagentsBox" />

					<Button Content="Добавить" Click="AddQuest_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Сохранить" Click="SaveQuest_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Удалить" Click="DeleteQuest_Click" MinHeight="40" HorizontalAlignment="Stretch" />

					<TextBlock x:Name="QuestMessage" Foreground="Red" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<TabItem Header="Прохождения">
			<ScrollViewer>
				<StackPanel Margin="10" Spacing="10">
					<ListBox x:Name="PlaythroughsList" MaxHeight="200" SelectionChanged="PlaythroughsList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Playthrough">
								<TextBlock TextWrapping="Wrap">
									<Run Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
									<Run Text=" | " />
									<Run Text="{Binding Team.TeamName}" />
									<Run Text=" - " />
									<Run Text="{Binding Quest.QuestTitle}" />
								</TextBlock>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<TextBlock Text="Выберите команду:" />
					<ComboBox x:Name="PlaythroughTeamCombo" HorizontalAlignment="Stretch" MinHeight="40" />

					<TextBlock Text="Выберите квест:" />
					<ComboBox x:Name="PlaythroughQuestCombo" HorizontalAlignment="Stretch" MinHeight="40" />

					<TextBlock Text="Дата:" />
					<CalendarDatePicker x:Name="PlaythroughDatePicker" HorizontalAlignment="Stretch" MinHeight="40" />

					<TextBlock Text="Время:" />
					<TimePicker x:Name="PlaythroughTimePicker" HorizontalAlignment="Stretch" MinHeight="40" />

					<CheckBox x:Name="PlaythroughIsSuccessBox" Content="Успешно" MinHeight="40" />

					<Button Content="Добавить" Click="AddPlaythrough_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Сохранить" Click="SavePlaythrough_Click" MinHeight="40" HorizontalAlignment="Stretch" />
					<Button Content="Удалить" Click="DeletePlaythrough_Click" MinHeight="40" HorizontalAlignment="Stretch" />

					<TextBlock x:Name="PlaythroughMessage" Foreground="Red" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</TabItem>
	</TabControl>
</UserControl>